{
  "$defs": {
    "Surface": {
      "description": "Where in the lab an attack payload (or its benign near-neighbor) lives.",
      "enum": [
        "visible_text",
        "hidden_dom",
        "tool_result",
        "role_spoofing",
        "misleading_workflow_notice",
        "link_or_redirect",
        "form_submission",
        "subresource_embed"
      ],
      "title": "Surface",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Provenance of a MODEL-GENERATED attack variant (generated cases only).",
  "properties": {
    "generated": {
      "const": true,
      "default": true,
      "title": "Generated",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "length_cap": {
      "maximum": 600,
      "minimum": 20,
      "title": "Length Cap",
      "type": "integer"
    },
    "mode": {
      "minLength": 1,
      "title": "Mode",
      "type": "string"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_case_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Seed Case Id",
      "type": "string"
    },
    "slot_text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Slot Text Sha256",
      "type": "string"
    },
    "surface": {
      "$ref": "#/$defs/Surface"
    },
    "tone": {
      "enum": [
        "formal",
        "urgent",
        "friendly",
        "technical"
      ],
      "title": "Tone",
      "type": "string"
    }
  },
  "required": [
    "seed_case_id",
    "provider",
    "model",
    "mode",
    "prompt_version",
    "prompt_hash",
    "surface",
    "tone",
    "length_cap",
    "slot_text_sha256",
    "generated_at"
  ],
  "title": "GenerationInfo",
  "type": "object"
}
