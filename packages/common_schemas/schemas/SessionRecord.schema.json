{
  "$defs": {
    "Arm": {
      "description": "Paired-experiment arm.",
      "enum": [
        "UNPROTECTED",
        "PROTECTED"
      ],
      "title": "Arm",
      "type": "string"
    },
    "SessionKind": {
      "enum": [
        "AGENT_RUN",
        "SCAN",
        "FIX",
        "GUARD",
        "CONTAINMENT"
      ],
      "title": "SessionKind",
      "type": "string"
    },
    "SessionState": {
      "enum": [
        "CREATED",
        "READY",
        "RUNNING",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "ANALYZED",
        "EXPORTED"
      ],
      "title": "SessionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arm": {
      "anyOf": [
        {
          "$ref": "#/$defs/Arm"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "fixture_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Version"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "kind": {
      "$ref": "#/$defs/SessionKind"
    },
    "model": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "policy_version": {
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "scenario_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario Id"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "$ref": "#/$defs/SessionState"
    },
    "target_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    }
  },
  "required": [
    "id",
    "kind",
    "state",
    "created_at",
    "policy_version"
  ],
  "title": "SessionRecord",
  "type": "object"
}
