{
  "$defs": {
    "ActorRole": {
      "enum": [
        "SYSTEM",
        "OPERATOR",
        "AGENT"
      ],
      "title": "ActorRole",
      "type": "string"
    },
    "SessionState": {
      "enum": [
        "CREATED",
        "READY",
        "RUNNING",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "ANALYZED",
        "EXPORTED"
      ],
      "title": "SessionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "actor_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "actor_role": {
      "$ref": "#/$defs/ActorRole"
    },
    "detail": {
      "default": "",
      "title": "Detail",
      "type": "string"
    },
    "from_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "to_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/SessionState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "actor_id",
    "actor_role",
    "action",
    "timestamp"
  ],
  "title": "AuditRecord",
  "type": "object"
}
