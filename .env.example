# Placeholders only. Copy to .env (git-ignored) and fill locally. NEVER commit real values.
# Verified facts about the hosted API: docs/DECISIONS.md ("Model API facts (verified ...)").

# nvidia (default) | baseten | together | fireworks | local | recorded | meta_api (disabled)
MODEL_PROVIDER=nvidia
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=meta/muse-glimmer-30b
MODEL_API_KEY=
SENTINELX_LOCAL_TOKEN=

# Optional tuning (defaults shown). The hosted rate limit is undocumented: keep this low.
# MODEL_MAX_RPM=20
# MODEL_RUN_CALL_CAP=8
# MODEL_EXPERIMENT_CALL_CEILING=400
# MODEL_EXPERIMENT_TOKEN_CEILING=1000000
# MODEL_MAX_TOKENS=2048
# MODEL_REASONING_EFFORT=low        # empty string disables the parameter
# MODEL_BREAKER_THRESHOLD=5
# MODEL_DEBUG_LOG_PROMPTS=0         # 1 puts (redacted) prompts into events; leave off
